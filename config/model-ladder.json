{
  "schema": "model-ladder-v3",
  "schema_minor": "3.1",
  "dec": "DEC-041 + addendum 2026-09-05 (local-tier amendment, native routing)",
  "derived_from": "docs/specs/gearbox/RECOMMISSION-TZ.md §6 (out-ultra-opus-r3 part 3)",
  "verified": "PENDING price-sync (P0). [L] = 2026-09-05 live; all others unverified",
  "tier_semantics": {
    "low": "cheapest live-priced CLOUD slug passing duty profile + invariant hierarchy",
    "medium": "duty-derived default under balanced",
    "high": "one declared trigger above medium",
    "ultra": "maximum; approval-gated; <=3 calls/task",
    "collapsed_low": "true when no cheaper legal live-priced slug exists; kick-down goes to mode or schedule",
    "fallback": "NOT a tier: the local box, capacity 1, priority-ordered, reachable only in state OFFLINE",
    "lane": "coder-only capacity-bearing channel; the coder's strength axis"
  },
  "states": {
    "ONLINE": "default",
    "DEGRADED": "per-slug LANE_DEATH / slug-busy / cooldown -> lateral, serialize, batch; never vertical",
    "OFFLINE": {
      "entry": ">=2 distinct vendors fail at connect level within 60s, or preset:offline",
      "routing": "fallback box, priority order, queue arbitrates",
      "exit": "next dispatch re-probes one cloud slug; TTL 300s; no polling, no daemon",
      "cost": 0
    },
    "BLOCKED": "OFFLINE and fallback unreachable -> operator await (sys.offline_blocked, S4)"
  },
  "fallback": {
    "slug": "local:gpt-oss-20b-MXFP4",
    "duties": [
      "role-coder host (lane local)",
      "system fallback in state OFFLINE"
    ],
    "capacity": 1,
    "preemption": false,
    "priority": [
      "role-coder",
      "role-overseer",
      "role-megathread",
      "master-of-security",
      "master-of-truth",
      "master-of-search",
      "master-of-probability"
    ],
    "council": "BLOCKED",
    "not_a_tier": true,
    "not_rotatable": true,
    "lease": "slug:local:gpt-oss-20b-MXFP4 (site-global, priority-ordered)"
  },
  "modes": {
    "sync": "default",
    "batch": "~50% price, asynchronous; the one-shot route (DEC-036)"
  },
  "batch_is_duty": "OFF: role-overseer, role-coder. ON: role-megathread intel high, master-of-security intel high, master-of-truth anchors, council, canaries, all one-shots",
  "rule_absent_tier": "nearest upper assigned tier on the same axis; if none, the highest assigned; log degraded=1; two consecutive degraded=1 on one task = BLOCKED",
  "invariants": {
    "I1_security": {
      "verifier_edge_disjoint": true,
      "artifact_vendor_exclusion": "a review call never runs on the vendor that produced the artifact (reason=vendor-exclusion)",
      "reserved_vendors": {
        "moonshot": "master-of-truth"
      },
      "council": ">=2 pairwise-distinct eligible after exclusions, else BLOCKED -> operator"
    },
    "I2_capacity": {
      "always_on_lanes_disjoint": [
        "role-overseer.talk",
        "role-megathread.talk"
      ],
      "one_consumer_per_slug_scope": "talk sessions + heavy intel (>2000 tok out or >30s); micro-calls exempt and yielding",
      "fallback": "capacity 1, priority-ordered"
    },
    "I3_hygiene": {
      "self_check_separation": "a role's intel axis avoids its own talk vendor concurrently",
      "lineage_rotation": "rotation avoids the lineage of the instance that just failed"
    },
    "lane_reachability": "coder cloud-strong reachable only from cloud-fast; direct local->cloud-strong requires operator force AND selects ultra_alt",
    "context_overflow": "step to the nearest assigned tier whose window fits; mechanical, no TTL cost",
    "ci_assertions": [
      "MT working vendors INTERSECT coder lane vendors (incl. ultra_alt) = empty",
      "council pool + reserve >= 3 distinct vendors",
      "moonshot only under master-of-truth",
      "no verifying edge shares a vendor after D12",
      "no slot with price_confidence != live is a lateral target or a models[] chain member",
      "the fallback slug appears only under fallback and role-coder.lanes.local",
      "the two always-on talk primaries differ in slug and vendor"
    ]
  },
